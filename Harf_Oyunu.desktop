[Desktop Entry]
Version=1.0
Type=Application
Name=Harf Oyunu
Comment=Türkçe harf oyunlarını başlat
TryExec=python3
Exec=python3 -c "import http.server, os, socketserver, subprocess, sys; os.chdir(os.path.dirname(sys.argv[1])); server = socketserver.TCPServer(('127.0.0.1', 0), http.server.SimpleHTTPRequestHandler); url = 'http://127.0.0.1:%%d' %% server.server_address[1]; subprocess.Popen(['xdg-open', url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); server.serve_forever()" %k
Icon=applications-games
Terminal=false
Categories=Game;
StartupNotify=true
